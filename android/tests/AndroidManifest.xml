<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cn.novelrelay.matcher.test">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
    <application android:label="Matcher integration checks" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="cn.novelrelay.matcher.ShareReceiver" android:label="Matcher test receiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/zip"/>
            </intent-filter>
        </activity>
    </application>
    <instrumentation android:name="cn.novelrelay.matcher.Checks" android:targetPackage="cn.novelrelay.matcher"/>
</manifest>
